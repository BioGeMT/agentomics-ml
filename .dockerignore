# Reduce Docker build context size for memory efficiency
.git
.gitignore
*.md
# Python package metadata requires the project readme during `pip install .`.
!README.md
*.cast
.env
.env.*
node_modules
__pycache__
*.pyc
*.pyo
*.pyd
.Python
env
pip-log.txt
pip-delete-this-directory.txt
.tox
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.cache
.pytest_cache
.hypothesis

# Exclude large directories that aren't needed in container
/.venv/
/.genomic_benchmarks/
/.miRBench/
/.free_spoken_digit_dataset/
/datasets/
/test_datasets/
/cache/
/wandb/
/cleanup_wandb_logs/
/runs/
/outputs/
/logs/
/temp/
/tmp/
/build/
/dist/
/site/
*.egg-info/
*.tmp

# Exclude local development tools
/.claude/
/.codex/
/.logfire/
/.agents/

# Exclude IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Exclude OS files
.DS_Store
Thumbs.db