FROM condaforge/mambaforge:24.9.2-0

# Create preparation environment
COPY environment_prepare.yaml .
RUN mamba env create -f environment_prepare.yaml \
    && mamba clean -afy

# Initialize conda
RUN conda init bash

# Set working directory
WORKDIR /repository
COPY pyproject.toml README.md ./
COPY src/agentomics ./src/agentomics
RUN conda run -n agentomics-prepare-env python -m pip install --no-deps /repository

# Set the default command to run preparation directly
ENTRYPOINT ["/opt/conda/envs/agentomics-prepare-env/bin/python", "-m", "agentomics.prepare_datasets"]
CMD ["--prepare-all"]
