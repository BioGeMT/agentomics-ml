# Agentomics Environment Variables
# Copy this file to .env and fill in your actual API keys

OPENROUTER_API_KEY=your_openrouter_api_key_here
# OR
OPENAI_API_KEY=your_openai_api_key_here
# OR See the Providers section in README.md for other supported providers

# Optional: Weights & Biases API Key for experiment tracking
# Get your key from: https://wandb.ai/settings
# WEAVE_DISABLE_NETRC_CHECK=true
# WANDB_API_KEY=your_wandb_api_key_here
# WANDB_PROJECT_NAME = "your_project_name_here"
# WANDB_ENTITY = "your_entity_name_here"