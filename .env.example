# Agentomics Environment Variables
# Copy this file to .env and fill in your actual API keys

OPENROUTER_API_KEY=your_openrouter_api_key_here
# OR
OPENAI_API_KEY=your_openai_api_key_here
# OR See the Providers section in README.md for other supported providers

# Optional: Scientific paper fetching
# Asta and Semantic Scholar use separate API keys.
# ASTA_API_KEY=your_asta_api_key_here
# S2_API_KEY=your_semantic_scholar_api_key_here
# Set a contact email to enable Unpaywall DOI lookups.
# UNPAYWALL_EMAIL=you@your-institution.org

# Optional: Weights & Biases / Weave experiment tracking
# Get your API key from: https://wandb.ai/authorize
# Uncomment all three WANDB_* variables to enable logging.
# WANDB_API_KEY=your_wandb_api_key_here
# WANDB_PROJECT_NAME=your_project_name_here
# WANDB_ENTITY=your_entity_or_team_here
